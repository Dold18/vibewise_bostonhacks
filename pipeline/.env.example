# Supabase project URL
SUPABASE_URL=
# Supabase secret key, never put in apps/web
SUPABASE_SECRET_KEY=
# Hugging Face token used to read the Foursquare OS Places dataset
HF_TOKEN=
# Foursquare OS Places release date (YYYY-MM-DD); defaults to the value in src/config.ts
FSQ_RELEASE=
# Gemini API key for npm run enrich:price
GEMINI_API_KEY=
# Optional Gemini model override for npm run enrich:price
GEMINI_MODEL=
# Optional Mapillary client token for street photos in npm run enrich:media; Mapillary is skipped without it
MAPILLARY_TOKEN=
