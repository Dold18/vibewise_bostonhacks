# MBTA V3 API key (https://api-v3.mbta.com/ , free key from the MBTA developer portal).
# Server-side / Node only: never expose it in browser code (no VITE_ prefix).
# Copy this file to .env (gitignored) and fill it in. Keyless requests work but are limited to 20/min.
MBTA_API_KEY=

# Gemini for the interactive adaptive quiz and offline enrichment.
# Obtain securely from the credential owner; never commit a real value.
# Server only: never prefix these with VITE_.
GEMINI_API_KEY=
VIBE_GEMINI_MODEL=gemini-3.8-flash
# Photo input: GEMINI_API_KEY and VIBE_GEMINI_MODEL above also describe signed-in users' photos.
# Dev only: lift the 5-per-day photo-read cap (sign-in is still required). Server only; never VITE_
# and never in apps/web/.env.
# VIBE_IMAGE_UNLIMITED=true
# Optional external env-file path and local model cache directory:
# VIBENTA_ENV_FILE=/absolute/path/to/.env
# VIBENTA_MODEL_CACHE=/private/tmp/vibenta-minilm-cache
# Browser settings (VITE_SUPABASE_*, VITE_CATALOG_EMBEDDING_MODEL_KEY) go in
# apps/web/.env; see apps/web/.env.example.

# Optional local development ports (defaults shown):
# VITE_PORT=5173
# TRANSIT_API_PORT=8787

# Server-side catalog search (POST /api/vibe/search) and photo sign-in checks (POST /api/vibe/describe-image,
# GET /api/vibe/photo-quota). The API reads this file, not apps/web/.env. The server falls back to the VITE_SUPABASE_URL /
# VITE_SUPABASE_PUBLISHABLE_KEY the browser uses, so set these only if those are not in this file.
# Publishable (anon) key only: never put a secret/service key here.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
