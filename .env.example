# MBTA V3 API key (https://api-v3.mbta.com/ , free key from the MBTA developer portal).
# Server-side / Node only: never expose it in browser code (no VITE_ prefix).
# Copy this file to .env (gitignored) and fill it in. Keyless requests work but are limited to 20/min.
MBTA_API_KEY=

# Gemini API key for the server-side adaptive Vibe Quiz (also used by offline pipeline enrichment).
# Obtain securely from the teammate managing credentials; never commit a real value.
# Server-side only: do not expose through VITE_ variables or browser code.
GEMINI_API_KEY=
