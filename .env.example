# MBTA V3 API key (https://api-v3.mbta.com/ , free key from the MBTA developer portal).
# Server-side / Node only: never expose it in browser code (no VITE_ prefix).
# Copy this file to .env (gitignored) and fill it in. Keyless requests work but are limited to 20/min.
MBTA_API_KEY=

# Gemini for the interactive adaptive quiz and offline enrichment.
# Obtain securely from the credential owner; never commit a real value.
# Server only: never prefix these with VITE_.
GEMINI_API_KEY=
VIBE_GEMINI_MODEL=gemini-2.5-flash
# Supabase project URL and publishable (anon) key for the browser app: place catalog and accounts.
# These ARE shipped to the browser (VITE_ prefix), so only ever the publishable key, never the secret one.
# Without them the app runs without the catalog and account features.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional external env-file path and local model cache directory:
# (On Vercel only /tmp is writable: set VIBENTA_MODEL_CACHE=/tmp/vibenta-minilm-cache.)
# VIBENTA_ENV_FILE=/absolute/path/to/.env
# VIBENTA_MODEL_CACHE=/private/tmp/vibenta-minilm-cache
# Only set after the catalog owner verifies the EXACT embedding configuration:
# VITE_CATALOG_EMBEDDING_MODEL_KEY=Xenova/all-MiniLM-L6-v2@751bff37182d3f1213fa05d7196b954e230abad9:fp32:mean:l2

# Optional local development ports (defaults shown):
# VITE_PORT=5173
# TRANSIT_API_PORT=8787
