# MBTA V3 API key (https://api-v3.mbta.com/ , free key from the MBTA developer portal).
# Server-side / Node only: never expose it in browser code (no VITE_ prefix).
# Copy this file to .env (gitignored) and fill it in. Keyless requests work but are limited to 20/min.
MBTA_API_KEY=

# Gemini for the interactive adaptive quiz and offline enrichment.
# Obtain securely from the credential owner; never commit a real value.
# Server only: never prefix these with VITE_.
GEMINI_API_KEY=
VIBE_GEMINI_MODEL=gemini-2.5-flash
# Optional extra env file outside the repository, read BEFORE this file (its values win; this file
# is still read for anything it leaves out), and the local model cache directory:
# VIBENTA_ENV_FILE=/absolute/path/to/.env
# VIBENTA_MODEL_CACHE=/absolute/path/to/model-cache   (default: <OS temp dir>/vibenta-minilm-cache)
# Browser settings (VITE_SUPABASE_*, VITE_CATALOG_EMBEDDING_MODEL_KEY) go in
# apps/web/.env; see apps/web/.env.example.

# Optional local development ports (defaults shown):
# VITE_PORT=5173
# TRANSIT_API_PORT=8787

# Server-side catalog search (POST /api/vibe/search), read-only.
# Publishable key only (sb_publishable_...): never put a secret/service-role key here.
# If left empty, the API falls back to VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY from apps/web/.env.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
