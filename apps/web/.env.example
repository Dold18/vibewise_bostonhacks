# Browser settings for the web app. Copy to apps/web/.env (gitignored).
# Everything here ships to the browser: only public values, never a secret key.
# Supabase project URL (the dashboard's .../rest/v1/ form also works).
VITE_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...). Never the secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=
